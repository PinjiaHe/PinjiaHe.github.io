---
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ResourceEntry from '../../components/ResourceEntry.astro';
import {showDrafts} from '../../lib/data';
import {localeFromPath, translator, localizeHref} from '../../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const resources = (await getCollection('resources',({data})=>data.visibility==='public')).sort((a,b)=>a.data.order-b.data.order);
const notes = (await getCollection('notes',({data})=>data.visibility==='public'||showDrafts)).sort((a,b)=>b.data.date.localeCompare(a.data.date));
---
<Layout title={t('Notes & Resources')} description={t('Recommended reading for research students and a space for original notes.')}><div class="container notes-page"><header class="page-hero"><p class="eyebrow">{t('Reading & writing')}</p><h1>{t('Notes & Resources')}</h1><p>{t('A place for research notes and useful reading.')}</p></header><section class="notes-articles"><h2>{t('Articles')}</h2>{notes.length===0 ? <p class="empty-state">{t('No original articles published yet.')}</p> : notes.map(note=><article class="resource-entry"><p class="eyebrow">{t(note.data.visibility==='draft' ? 'Local draft · Test fixture' : 'Article')} · {note.data.lang}</p><h3><a href={localizeHref(`/notes/${note.data.slug}/`, locale)}>{note.data.title}</a></h3><p>{note.data.summary}</p><p class="resource-author">{note.data.author} · {note.data.date}</p></article>)}</section><section class="section"><div class="section-heading"><div><h2>{t('Recommended Reading')}</h2></div></div><div class="resource-grid">{resources.map(resource=><ResourceEntry resource={resource}/>)}</div><p class="section-note">{t('External resources open at their original source and are credited to their authors.')}</p></section></div></Layout>

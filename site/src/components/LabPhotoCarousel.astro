---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/lab/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);
const photos = Object.entries(images)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([path, image]) => ({
    image: image.default,
    alt: path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' '),
  }));
---
{photos.length > 0 && <section class="lab-photo-carousel" role="region" aria-roledescription="carousel" aria-label="Lab photos">
  <div class="lab-photo-frame">
    {photos.map((photo, index) => <div class="lab-photo-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${photos.length}`} hidden={index !== 0}>
      <Image src={photo.image} alt={photo.alt || 'Lab photo'} width={1000} widths={[480, 800, 1200]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1100px) 52vw, 570px" format="webp" quality={82} loading="lazy" decoding="async" />
    </div>)}
  </div>
  {photos.length > 1 && <div class="lab-photo-controls" hidden>
    <span class="visually-hidden" data-photo-status aria-live="off" aria-atomic="true">1 / {photos.length}</span>
    <button type="button" data-photo-previous aria-label="Previous photo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg></button>
    <button type="button" data-photo-next aria-label="Next photo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
  </div>}
</section>}

<script>
  document.querySelectorAll<HTMLElement>('.lab-photo-carousel').forEach(carousel => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.lab-photo-slide'));
    const controls = carousel.querySelector<HTMLElement>('.lab-photo-controls');
    if (slides.length < 2 || !controls) return;

    const previous = controls.querySelector<HTMLButtonElement>('[data-photo-previous]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-photo-next]')!;
    const status = controls.querySelector<HTMLElement>('[data-photo-status]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let hovered = false;
    let focused = false;
    let inView = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    function schedule() {
      clearTimeout(timer);
      if (!reducedMotion.matches && inView && !hovered && !focused && !document.hidden) {
        timer = setTimeout(() => show(index + 1), 3000);
      }
    }

    function preloadNext() {
      const image = slides[(index + 1) % slides.length].querySelector('img');
      if (image) image.loading = 'eager';
    }

    function show(position: number, manual = false) {
      slides[index].hidden = true;
      index = (position + slides.length) % slides.length;
      slides[index].hidden = false;
      status.setAttribute('aria-live', manual ? 'polite' : 'off');
      status.textContent = `${index + 1} / ${slides.length}`;
      preloadNext();
      schedule();
    }

    previous.addEventListener('click', () => show(index - 1, true));
    next.addEventListener('click', () => show(index + 1, true));
    carousel.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse') { hovered = true; schedule(); }
    });
    carousel.addEventListener('pointerleave', () => { hovered = false; schedule(); });
    carousel.addEventListener('focusin', event => {
      focused = event.target instanceof HTMLElement && event.target.matches(':focus-visible');
      schedule();
    });
    carousel.addEventListener('focusout', event => {
      focused = event.relatedTarget instanceof HTMLElement && carousel.contains(event.relatedTarget) && event.relatedTarget.matches(':focus-visible');
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    reducedMotion.addEventListener('change', schedule);
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting && entry.intersectionRatio > 0.1;
      if (inView) preloadNext();
      schedule();
    }, { threshold: [0, 0.1] }).observe(carousel);

    controls.hidden = false;
    schedule();
  });
</script>

<style>
  .lab-photo-carousel { min-width:0; align-self:center; }
  .lab-photo-frame { aspect-ratio:3 / 2; overflow:hidden; border-radius:8px; }
  .lab-photo-slide, .lab-photo-slide img { width:100%; height:100%; }
  .lab-photo-slide img { object-fit:contain; }
  .lab-photo-controls { display:flex; align-items:center; justify-content:center; gap:24px; margin-top:4px; opacity:0; pointer-events:none; }
  .lab-photo-carousel:hover .lab-photo-controls, .lab-photo-carousel:has(:focus-visible) .lab-photo-controls { opacity:1; pointer-events:auto; }
  .lab-photo-controls[hidden] { display:none; }
  .lab-photo-controls button { display:grid; place-items:center; width:44px; height:40px; padding:8px; border:0; background:none; color:var(--muted); cursor:pointer; }
  .lab-photo-controls button:hover { color:var(--accent); }
  .lab-photo-controls button:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
  @media (hover:none), (pointer:coarse) {
    .lab-photo-controls { opacity:1; pointer-events:auto; }
  }
</style>

---
import {localeFromPath} from '../lib/locale';
const chineseShell = localeFromPath(Astro.url.pathname) === 'zh';
import type {CollectionEntry} from 'astro:content';
interface Props {resource:CollectionEntry<'resources'>;}
const {data:r} = Astro.props.resource;
---
<article lang={chineseShell ? r.lang : undefined} class="resource-entry"><p class="eyebrow">Recommended Reading <span>· {r.lang === 'en' ? 'EN' : '中文'}</span></p><h3><a href={r.url}>{r.title}</a></h3><p class="resource-author">{r.author}</p>{r.recommendation && <p>{r.recommendation}</p>}</article>

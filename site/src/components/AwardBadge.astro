---
import {localeFromPath, translator} from '../lib/i18n';
const t = translator(localeFromPath(Astro.url.pathname));
interface Props { label: string; }
const {label} = Astro.props;
const displayLabel = t(label);
---
<span class="award-badge" lang={displayLabel !== label ? 'zh-CN' : undefined}><svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3h8v7a4 4 0 0 1-8 0V3Zm4 11v6m-4 1h8M8 5H4v3a4 4 0 0 0 4 4m8-7h4v3a4 4 0 0 1-4 4"/></svg>{displayLabel}</span>

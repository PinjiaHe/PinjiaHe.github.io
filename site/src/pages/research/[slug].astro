---
import {getCollection,render} from 'astro:content';
import type {CollectionEntry} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PublicationEntry from '../../components/PublicationEntry.astro';
import PublicationLegend from '../../components/PublicationLegend.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
export async function getStaticPaths() { return (await getCollection('projects',({data})=>data.visibility==='public')).map(project=>({params:{slug:project.data.slug},props:{project}})); }
interface Props {project:CollectionEntry<'projects'>;}
import {localeFromPath, translator, localizeHref} from '../../lib/i18n';
import {localizedProject} from '../../lib/translations';
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const {entry:project, content} = await localizedProject(Astro.props.project, locale);
const {Content} = await render(content);
const sourceUrl = project.data.sources.find(source => /^https?:\/\//.test(source));
const all = await getCollection('publications',({data})=>data.visibility==='public');
const publications = project.data.publicationIds.map(id=>all.find(p=>p.id===id)!);
---
<Layout title={project.data.title} description={project.data.summary}><article class="container project-detail"><a class="back-link" href={localizeHref('/research/', locale)}>{t('Research')}</a><header class="page-hero"><p class="eyebrow">{t('Selected work')}</p><h1>{project.data.title}</h1><p>{project.data.summary}</p><div class="publication-links">{Object.entries(project.data.links).map(([label,href])=><a href={href}>{t(label)}</a>)}</div></header><ProjectFigure project={project} /><div class="prose article-body"><Content /></div>{project.data.evidence.length>0 && <section class="evidence"><h2>{t('Evidence in Context')}</h2>{project.data.evidence.map(e=><div><h3>{e.label}</h3><p>{e.value} {e.text}</p>{e.scope && <p>{e.scope}</p>}<a href={e.sourceUrl}>{t('Source')}{e.asOf && ` · ${e.asOf}`}</a></div>)}</section>}<section class="section"><h2>{t('Related Publications')}</h2><PublicationLegend />{publications.map(publication=><PublicationEntry publication={publication}/>)}</section><p class="source-note">{t('Summary based on the ')}{sourceUrl ? <a href={sourceUrl}>{t('linked public source')}</a> : t('public source')}{t('.')}</p></article></Layout>

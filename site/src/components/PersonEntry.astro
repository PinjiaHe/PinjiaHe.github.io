---
import type { CollectionEntry } from 'astro:content';
import { activeMembership, lastMembership, publicationSummaries } from '../lib/people';
import { localeFromPath, translator, memberText, localizeHref } from '../lib/i18n';
import PersonPublications from './PersonPublications.astro';
interface Props { person:CollectionEntry<'people'>; publications:CollectionEntry<'publications'>[]; compact?:boolean; membershipId?:string; }
const {person,publications,compact=false,membershipId} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const m = (text?:string) => memberText(text,locale);
const isChinese = locale === 'zh';
const p = person.data;
const active = activeMembership(p);
const selected = membershipId ? p.memberships.find(m => m.id === membershipId) : undefined;
if (membershipId && !selected) throw new Error(`Unknown membership ${membershipId} for ${p.id}`);
const primary = selected ?? active ?? lastMembership(p);
const showRole = !compact || !!selected || primary.role === 'postdoc';
const labels:Record<string,string> = isChinese
  ? {phd:'博士生',mphil:'研究型硕士生',msc:'MSc 硕士生',masters:'MPhil / 硕士生',ra:'研究助理',undergraduate:'本科实习生',postdoc:'博士后',visitor:'访问成员',other:'研究人员'}
  : {phd:'PhD',mphil:'MPhil',msc:'MSc',masters:"MPhil / Master's student",ra:'Research assistant',undergraduate:'Undergraduate intern',postdoc:'Postdoc',visitor:'Visitor',other:'Researcher'};
const period = (membership: typeof primary) => [membership.start, membership.status === 'active' ? (isChinese ? '至今' : 'present') : membership.end].filter(Boolean).join(' – ');
const showAchievements = !selected || !active;
const papers = showAchievements ? publicationSummaries(p, publications.map(p => p.data)) : [];
const notes = selected ? [] : [
  ...(compact && !showRole && period(primary) ? [period(primary)] : []),
  ...(p.previously === false ? [] : p.previously ? [`${isChinese ? '此前：' : 'Previously: '}${m(p.previously)}`] : p.memberships.filter(membership => membership.id !== primary.id).map(membership => `${membership.status === 'active' ? (isChinese ? '其他在组身份：' : 'Additional current role: ') : (isChinese ? '此前：' : 'Previously: ')}${membership.label ? m(membership.label) : labels[membership.role]}${period(membership) ? ` · ${period(membership)}` : ''}`)),
  ...(primary.supervisors?.length ? [isChinese ? `由 ${primary.supervisors.join(' 和 ')} 共同指导` : `Co-supervised by ${primary.supervisors.join(' and ')}`] : []),
  ...p.notes.map(note => m(note)),
];
---
<article class:list={['person-entry',{'person-entry-compact':compact}]} id={selected ? `${p.id}--${selected.id}` : p.id} data-person-id={p.id}>
  {!compact && !selected && p.photo && <img class="person-photo" src={p.photo} alt={m(p.photoAlt ?? p.name)} width="72" height="72" loading="lazy" />}
  <div class="person-content">
    <h3>{p.website ? <a href={localizeHref(p.website,locale)}>{m(p.name)}</a> : m(p.name)}</h3>
    {showRole && <p class="person-role">{primary.label ? m(primary.label) : labels[primary.role]}{period(primary) && ` · ${period(primary)}`}</p>}
    {!selected && (!compact || p.entryStyle === 'full') && p.education.length > 0 && <ul class="education">{p.education.map(e => <li>
      {[e.degree,e.program,e.institution].filter(Boolean).map(value => m(value)).join(isChinese ? '，' : ', ')}{e.period && ` (${e.period})`}
      {e.rank && <span class="education-rank">{m(e.rank.display)} · {m(e.rank.scope)}{e.rank.asOf && ` · ${e.rank.asOf}`}</span>}
      {(e.details?.length > 0 || e.publicationSummary?.length > 0) && <ul class="education-details" role="list">
        {e.publicationSummary?.length > 0 && <li>{t('Publications')}{isChinese ? '：' : ': '}{e.publicationSummary.map((paper,index) => <>{index > 0 && ', '}<span class:list={{'first-author-publication':paper.firstAuthor}}>{paper.url ? <a href={localizeHref(paper.url,locale)}>{paper.label}</a> : paper.label}</span></>)}</li>}
        {e.details?.map(detail => <li>{m(detail)}</li>)}
      </ul>}
    </li>)}</ul>}
    <PersonPublications papers={papers}/>
    {showAchievements && p.awards.length > 0 && <p class="person-detail"><span class="field-label">{t('Awards')}</span><span class="person-detail-values">{p.awards.map(award => <span class="person-detail-item">{m(award)}</span>)}</span></p>}
    {!selected && p.visits.length > 0 && <p class="person-detail"><span class="field-label">{t('Visits')}</span>{p.visits.map(visit => m(visit)).join(isChinese ? '；' : '; ')}</p>}
    {(selected ? primary.status === 'completed' : !active) && primary.nextStep && <p class="next-step"><span class="field-label">{t('Next')}</span>{m(primary.nextStep.label)}{primary.nextStep.status === 'offer' && (isChinese ? '（已获录取或聘用通知）' : ' (offer)')}</p>}
    {showAchievements && p.currentPosition && <p class="next-step current-position"><span class="field-label">{t('Current')}</span>{m(p.currentPosition.label)}</p>}
    {notes.length > 0 && <p class="person-detail person-notes"><span class="field-label">{isChinese ? '备注' : 'Notes'}</span>{notes.join(isChinese ? '；' : '; ')}</p>}
  </div>
</article>

---
import { localeFromPath, translator, memberText, localizeHref } from '../lib/i18n';
interface Props { papers: {label:string; firstAuthor:boolean; url?:string}[]; label?:string; }
const {papers,label='Publications'} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
---
{papers.length > 0 && <p class="person-detail person-publications"><span class="field-label">{t(label)}</span>{papers.map((paper,index) => <>{index > 0 && ', '}<span class:list={{'first-author-publication':paper.firstAuthor}}>{paper.url ? <a href={localizeHref(paper.url,locale)}>{memberText(paper.label,locale)}</a> : memberText(paper.label,locale)}</span></>)}</p>}
